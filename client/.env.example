# OmniMart React Client — Environment Variables
# Copy this file to .env and fill in your values

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get yours from: https://console.cloud.google.com
#   1. Create a project
#   2. APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   3. Application type: Web application
#   4. Authorised JavaScript origins: http://localhost:5173
#   5. Copy the Client ID below
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── API Configuration ─────────────────────────────────────────────────────────
# For LOCAL DEV: Leave VITE_API_URL blank or unset.
#   The Vite dev server proxy will forward /api requests to http://localhost:5000
#
# For PRODUCTION (Vercel / Netlify / etc.):
#   Set VITE_API_URL to your deployed Express backend full base path:
VITE_API_URL=https://your-backend-api.onrender.com/api/v1

# Optional: Override the Vite proxy target for local dev (default: http://localhost:5000)
# Useful if your backend runs on a different port in a team environment.
VITE_API_TARGET=http://localhost:5000
